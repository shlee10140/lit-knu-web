# LIT x MSA 250 Challenge - Environment Variables Configuration Template
# 주의: 본 파일은 예시 템플릿입니다. 실제 비밀키는 .env 및 Azure Static Web Apps [구성 > 애플리케이션 설정]에만 등록하세요.

# 1. 관리자 및 세션 토큰 보안 (서버 사이드 전용)
ADMIN_PASSWORD=your_secure_admin_password_here
SESSION_SECRET=your_random_64_hex_secret_here

# 2. Google Gemini Vision API (서버 사이드 전용)
GEMINI_API_KEY=your_gemini_api_key_here

# 3. Azure Cosmos DB NoSQL API (Azure Functions 백엔드 전용)
COSMOS_ENDPOINT=https://<your-cosmos-account>.documents.azure.com:443/
COSMOS_KEY=your_cosmos_primary_key_here
COSMOS_DATABASE=litdb
COSMOS_CONTAINER=members
